# Banco de Dados PostgreSQL
POSTGRES_USER=funil
POSTGRES_PASSWORD=funil
POSTGRES_DB=funil
DATABASE_URL=postgresql://funil:funil@localhost:5432/funil?schema=public

# Backend API
PORT=3001
FUNIL_CORS_ORIGENS=*
# 1 habilita /api/v1/admin/* | 0 desabilita em produção se necessário
FUNIL_PERMITIR_ADMIN=1
# Opcional: exige cabeçalho X-Admin-Token nas rotas administrativas
FUNIL_ADMIN_TOKEN=
